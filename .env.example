# GearGrid: every environment variable (spec 4.3). Copy this file to .env.local (git-ignored) and fill it in.
# Never put real values in this file.
#
# Supabase URLs use the session pooler (port 5432) and end with
#   ?sslmode=verify-full&sslrootcert=<absolute path of certs/supabase-root-2021.crt>

# Scripts (migrations, roles, seed, reset): the project's postgres role
MIGRATION_DATABASE_URL=

# API, from slice B: the app_api role (app_api.<project-ref>)
DATABASE_URL=

# Passwords that db:roles sets on the two roles
APP_API_PASSWORD=
DOKAAN_RO_PASSWORD=

# Value of the test API key the seed creates: ggk_ plus 32 base62 characters (D22)
SEED_API_KEY=

# ci, dev or prod; destructive scripts refuse prod
GEARGRID_ENV=dev

# Web dashboard login, from slice C (DokaanBondhu spec D193): the Supabase project's address and publishable key.
# Without them the API works as before and the pages say login is not set up.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Only for `npm run auth:owner` on the laptop (makes the owner's login): the project's secret key and the password.
# Never put these on a server.
SUPABASE_SECRET_KEY=
OWNER_PASSWORD=

# CI only: the page tests' stand-in login (works only when GEARGRID_ENV=ci and Supabase is not set)
WEB_TEST_PASSWORD=
