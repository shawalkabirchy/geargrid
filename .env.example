# GearGrid: every environment variable (spec 4.3). Copy this file to .env.local (git-ignored) and fill it in.
# Never put real values in this file.
#
# Supabase URLs use the session pooler (port 5432) and end with
#   ?sslmode=verify-full&sslrootcert=<absolute path of certs/supabase-root-2021.crt>

# Scripts (migrations, roles, seed, reset): the project's postgres role
MIGRATION_DATABASE_URL=

# API, from slice B: the app_api role (app_api.<project-ref>)
DATABASE_URL=

# Passwords that db:roles sets on the two roles
APP_API_PASSWORD=
DOKAAN_RO_PASSWORD=

# Value of the test API key the seed creates: ggk_ plus 32 base62 characters (D22)
SEED_API_KEY=

# ci, dev or prod; destructive scripts refuse prod
GEARGRID_ENV=dev
